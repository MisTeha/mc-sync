# Install:  sudo cp mc-bot.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now mc-bot
# Logs:     journalctl -u mc-bot -f

[Unit]
Description=Minecraft Discord bot
After=network-online.target docker.service
Wants=network-online.target

[Service]
# A user that is in the docker group and can read /opt/minecraft
User=YOUR_USER
WorkingDirectory=/opt/mc-sync/bot
EnvironmentFile=/opt/mc-sync/bot/.env
ExecStart=/opt/mc-sync/bot/.venv/bin/python bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
