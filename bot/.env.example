# Copy to .env and fill in. Keep .env private (chmod 600).
DISCORD_TOKEN=paste-bot-token-here
DISCORD_GUILD_ID=123456789012345678
ALLOWED_ROLE=Minecraft Admin

MC_ROOT=/opt/minecraft
PLAYBOOK_DIR=/opt/mc-sync/vps
# Full path if ansible isn't on systemd's PATH, e.g. /home/you/.local/bin/ansible-playbook
ANSIBLE_PLAYBOOK=ansible-playbook
